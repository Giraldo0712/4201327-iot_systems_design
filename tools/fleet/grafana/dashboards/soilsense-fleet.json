{
  "uid": "soilsense-fleet",
  "title": "SoilSense fleet",
  "tags": [
    "soilsense"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Seconds since the last report",
      "description": "Red when a node has sent nothing for 150 s: dead battery, crash, out of range, or removed.",
      "datasource": {
        "type": "influxdb",
        "uid": "soilsense-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "soilsense-influx"
          },
          "query": "from(bucket: \"soilsense\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"env\" or r._measurement == \"health\")\n  |> group(columns: [\"node\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, node: r.node, _field: \"age\",\n                      _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "displayName": "${__field.labels.node}"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Failed DTLS handshakes",
      "description": "Handshakes the node refused since it booted: a wrong key in the field, or someone trying keys.",
      "datasource": {
        "type": "influxdb",
        "uid": "soilsense-influx"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "soilsense-influx"
          },
          "query": "from(bucket: \"soilsense\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"health\" and r._field == \"hsfail\")\n  |> group(columns: [\"node\"])\n  |> last()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "displayName": "${__field.labels.node}"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "description": "Time since boot. A drop means the node rebooted.",
      "datasource": {
        "type": "influxdb",
        "uid": "soilsense-influx"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "soilsense-influx"
          },
          "query": "from(bucket: \"soilsense\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"health\" and r._field == \"up\")\n  |> group(columns: [\"node\"])\n  |> last()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "displayName": "${__field.labels.node}"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Soil temperature",
      "description": "/env/temp from every node.",
      "datasource": {
        "type": "influxdb",
        "uid": "soilsense-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "soilsense-influx"
          },
          "query": "from(bucket: \"soilsense\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"env\" and r._field == \"t\")\n  |> group(columns: [\"node\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": null,
          "max": null,
          "displayName": "${__field.labels.node}",
          "custom": {
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Battery",
      "description": "Simulated on the lab boards. Below 3000 mV: plan a battery swap.",
      "datasource": {
        "type": "influxdb",
        "uid": "soilsense-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "soilsense-influx"
          },
          "query": "from(bucket: \"soilsense\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"health\" and r._field == \"batt\")\n  |> group(columns: [\"node\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: mV",
          "min": 2700,
          "max": 3400,
          "displayName": "${__field.labels.node}",
          "custom": {
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "transparent",
                "value": 3000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Link RSSI",
      "description": "Average RSSI of the link each node depends on. Below -90 dBm the link is at risk.",
      "datasource": {
        "type": "influxdb",
        "uid": "soilsense-influx"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "soilsense-influx"
          },
          "query": "from(bucket: \"soilsense\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"health\" and r._field == \"rssi\")\n  |> group(columns: [\"node\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "min": -100,
          "max": -10,
          "displayName": "${__field.labels.node}",
          "custom": {
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "transparent",
                "value": -90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Fleet",
      "datasource": {
        "type": "influxdb",
        "uid": "soilsense-influx"
      },
      "description": "One row per node: its latest health report, and how long ago anything arrived from it.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "soilsense-influx"
          },
          "query": "health = from(bucket: \"soilsense\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"health\")\n  |> group(columns: [\"node\", \"_field\"])\n  |> last()\n  |> keep(columns: [\"node\", \"_field\", \"_value\"])\nage = from(bucket: \"soilsense\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"env\" or r._measurement == \"health\")\n  |> group(columns: [\"node\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({node: r.node, _field: \"age\",\n                      _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))\nunion(tables: [health, age])\n  |> group()\n  |> pivot(rowKey: [\"node\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"node\", \"age\", \"batt\", \"rssi\", \"up\", \"hsfail\", \"ver\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "node": 0,
              "age": 1,
              "batt": 2,
              "rssi": 3,
              "hsfail": 4,
              "up": 5,
              "ver": 6
            },
            "renameByName": {
              "age": "last report",
              "batt": "battery",
              "rssi": "link RSSI",
              "hsfail": "failed handshakes",
              "up": "uptime",
              "ver": "firmware"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "last report"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 150
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "battery"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: mV"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 3000
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "link RSSI"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dBm"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": -90
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed handshakes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    }
  ]
}
